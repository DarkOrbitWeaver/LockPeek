<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LockPeek.App"
        x:Class="LockPeek.App.MainWindow"
        Title="LockPeek">
    <Grid x:Name="Root" Background="{ThemeResource WindowBrush}" AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="12,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" Source="ms-appx:///assets/taskbar/lockpeek-light.svg"/>
                <TextBlock Text="LockPeek" FontSize="12"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,8,24,16" Spacing="4">
            <TextBlock x:Name="Headline" Text="Checking for apps…" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Grid x:Name="SelectionHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalAlignment="Center">
                    <StackPanel x:Name="FileSummary" Orientation="Horizontal" Spacing="12"/>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="Rescan" Click="RescanClick" IsEnabled="False" Padding="8,4" ToolTipService.ToolTip="Rescan" AutomationProperties.Name="Rescan">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Rescan"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="RecycleHint" Text="Close apps if needed, then review the items before deleting." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}" Visibility="Collapsed"/>
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0">
            <Grid x:Name="Landing" Visibility="Collapsed">
                <Rectangle x:Name="DropOutline" Stroke="{ThemeResource MutedBrush}" StrokeDashArray="4,3" StrokeThickness="1" RadiusX="8" RadiusY="8" IsHitTestVisible="False"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="20" MaxWidth="480">
                    <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource BrandAccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop files or folders here" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LandingSummary" Text="Choose what you want to check." TextAlignment="Center" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <ScrollViewer x:Name="LandingPreview" Visibility="Collapsed" MaxWidth="340" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                            <StackPanel x:Name="LandingItems" Orientation="Horizontal" Spacing="12"/>
                        </ScrollViewer>
                        <HyperlinkButton x:Name="ClearSelection" Content="Clear" Click="ClearSelectionClick" Visibility="Collapsed" Padding="4,2"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button x:Name="AddFiles" Content="Add files" Click="PickFiles"/>
                        <Button Content="Add folder" Click="PickFolder"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border x:Name="ResultsCard" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <CheckBox x:Name="SelectAll" Content="Select all eligible" Margin="14,4,100,4" FontSize="12" Foreground="{ThemeResource MutedBrush}" Click="SelectEligible"/>
                        <Button x:Name="RescanInList" Click="RescanClick" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,8,2" Padding="8,4" ToolTipService.ToolTip="Rescan" AutomationProperties.Name="Rescan">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                <TextBlock Text="Rescan"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" SelectionChanged="SelectionChanged" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource LineBrush}" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProcessRow">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" BorderBrush="Transparent" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                    <Expander.Resources>
                                        <SolidColorBrush x:Key="ExpanderBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ExpanderDropDownBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ExpanderHeaderBorderPressedBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent"/>
                                        <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                                    </Expander.Resources>
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="32" Height="32">
                                                <FontIcon Glyph="&#xE7C4;" FontSize="18" Visibility="{Binding IconFallbackVisibility}"/>
                                                <Image Width="32" Height="32" Source="{Binding Icon}" Stretch="Uniform"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                            </StackPanel>
                                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                                <Border Visibility="{x:Bind WarningVisibility}" CornerRadius="10" Padding="8,2" Background="{ThemeResource WarningBadgeBrush}">
                                                    <TextBlock Text="May have unsaved work" FontSize="12" Foreground="{ThemeResource WarningTextBrush}"/>
                                                </Border>
                                                <Border Visibility="{x:Bind ExcludedVisibility}" CornerRadius="10" Padding="8,2" Background="{ThemeResource WindowBrush}" ToolTipService.ToolTip="{x:Bind Reason}">
                                                    <TextBlock Text="{x:Bind Reason}" MaxWidth="240" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="8" Padding="12,4,12,12">
                                        <TextBlock Text="{x:Bind ProcessId}" FontSize="13"/>
                                        <TextBlock Text="{x:Bind Executable}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="{x:Bind IdentityDetails}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Reason}" FontSize="13" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Copy details" Click="CopyDetails" Tag="{x:Bind}"/>
                                            <Button Content="Open app location" Click="OpenLocation" Tag="{x:Bind}" IsEnabled="{x:Bind Target.Evidence.Verified}"/>
                                        </StackPanel>
                                        <TextBlock Text="Individual file associations have not been verified." FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid x:Name="OutcomeView" Visibility="Collapsed" VerticalAlignment="Top" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="OutcomeSearch" Visibility="Collapsed" PlaceholderText="Find an item" TextChanged="OutcomeSearchChanged"/>
                <ListView x:Name="OutcomeRows" Grid.Row="1" VerticalAlignment="Top" MaxHeight="280" SelectionMode="None" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:OutcomeRow">
                            <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="{x:Bind SeparatorThickness, Mode=OneTime}" Padding="10,6" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Grid Width="24" Height="24" Visibility="{x:Bind AppIconVisibility}">
                                                <FontIcon Glyph="&#xE7C4;" FontSize="16" Visibility="{Binding SourceRow.IconFallbackVisibility}"/>
                                                <Image Source="{Binding SourceRow.Icon}" Width="24" Height="24" Stretch="Uniform"/>
                                            </Grid>
                                            <FontIcon Width="24" Height="24" Glyph="{x:Bind ItemGlyph}" Visibility="{x:Bind ItemIconVisibility}" FontSize="16"/>
                                            <TextBlock Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind ItemPath}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Message}" Visibility="{x:Bind MessageVisibility}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StatusText}" Visibility="{x:Bind EndedVisibility}" Foreground="{ThemeResource SuccessTextBrush}" FontSize="12"/>
                                        <TextBlock Text="{x:Bind StatusText}" Visibility="{x:Bind RunningVisibility}" Foreground="{ThemeResource WarningTextBrush}" FontSize="12"/>
                                        <TextBlock Text="{x:Bind StatusText}" Visibility="{x:Bind OtherVisibility}" Foreground="{ThemeResource MutedBrush}" FontSize="12"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <HyperlinkButton x:Name="ShowAllOutcomes" Grid.Row="2" Visibility="Collapsed" Click="ShowAllOutcomesClick" Padding="0,4" HorizontalAlignment="Left"/>
            </Grid>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Spacing="12" Margin="16">
                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                    <Viewbox x:Name="EmptyCheck" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{ThemeResource BrandAccentBrush}" StrokeThickness="1.8"/>
                            <Path Data="M7.5 12.5l3 3 6-6.5" Stroke="{ThemeResource BrandAccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <FontIcon x:Name="EmptyIcon" Glyph="&#xE7BA;" FontSize="40" Foreground="{ThemeResource BrandAccentBrush}"/>
                </Grid>
                <TextBlock x:Name="EmptyTitle" Text="" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="EmptyDescription" Text="" FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="24,4,24,0" Spacing="4">
            <TextBlock x:Name="Status" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
            <Expander x:Name="Coverage" Header="What couldn't be checked" Visibility="Collapsed" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="160">
                    <TextBlock x:Name="CoverageText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </Expander>
        </StackPanel>

        <Grid x:Name="ActionBar" Grid.Row="4" Margin="24,8,24,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <TextBlock x:Name="ReportStatus" Text="{Binding Text, ElementName=Status, Mode=OneWay}" Visibility="Collapsed" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SupportButton" ToolTipService.ToolTip="Support on Ko-fi" AutomationProperties.Name="Support on Ko-fi" Click="SupportClick">
                        <Image Width="22" Height="22" Source="ms-appx:///assets/support/kofi.png"/>
                    </Button>
                    <TextBlock x:Name="SupportThanks" Text="Thanks! :)" Visibility="Collapsed" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                    <Button x:Name="CancelScan" Content="Cancel" Click="CancelClick" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartScan" Content="Find apps" Click="StartScanClick" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="ReviewRemaining" Content="Review remaining apps" Click="ReviewRemainingClick" Visibility="Collapsed"/>
                <Button x:Name="Done" Content="Done" Click="DoneClick" Visibility="Collapsed"/>
                <Button x:Name="Recycle" Foreground="{ThemeResource DestructiveTextBrush}" Content="Delete" Click="RecycleClick" Visibility="Collapsed" IsEnabled="False" ToolTipService.ToolTip="Review selected items before deleting" AutomationProperties.Name="Delete selected items"/>
                <Button x:Name="NormalClose" Content="Close normally" Style="{StaticResource AccentButtonStyle}" Click="CloseClick" IsEnabled="False"/>
                <Button x:Name="ForceEnd" Content="Force end selected" Click="ForceClick" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
